# 无密钥可以打开界面，但不能验证真实 AI 分析或模型连接。
HOST=127.0.0.1
PORT=3000
# 仅开发模式使用。通过反向代理或云端预览访问时，浏览器发出的 Host 会被 Vite
# 默认拒绝（403）。填写逗号分隔的域名列表（前缀 . 匹配所有子域名）或 * 放行全部。
# 例如：FINTRUST_DEV_ALLOWED_HOSTS=.e2b.app
FINTRUST_DEV_ALLOWED_HOSTS=
# 本地个人研究数据库，不上传 Git；建议使用新的 data-local 目录。
FINTRUST_DATA_DIR=./data-local
# 可读、可直接备份的长期投研记忆；每个项目一个 Markdown 文件。
FINTRUST_MEMORY_DIR=./research-memory
# Local MVP upload root. User PDF bytes, parser manifest/spans and receipts are
# stored here; keep this directory private and outside the checked-in database.
FINTRUST_UPLOAD_STORAGE_DIR=./uploads-local

# 当前核心模型：Ling-3.0-flash-Fin，沿用 OpenRouter 接入。
# 将本文件复制为 .env 后，在本地填写 Key，不要提交或发到聊天中。
FINTRUST_LLM_BASE_URL=https://openrouter.ai/api/v1
FINTRUST_LLM_MODEL=inclusionai/ling-3.0-flash-fin:free
FINTRUST_LLM_API_KEY=

# 旧 Gemini 配置仅保留兼容；本轮 Ling 连通验收不使用它代替指定模型。
GEMINI_API_KEY=
GEMINI_MODEL=

# MVP 每次上传只做一次核心分析调用；该上限保留给底层客户端保护。
FINTRUST_MAX_MODEL_CALLS=2
FINTRUST_MAX_OUTPUT_TOKENS=24000
FINTRUST_MODEL_TIMEOUT_MS=45000
